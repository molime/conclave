# Conclave secrets. Copy to .env and fill in. NEVER commit .env.

# --- The one key that unlocks the cheap council (GLM, Qwen, DeepSeek, Kimi) ---
# Get it at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: override OpenRouter base (defaults to https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Fully-local alternative (no key). Needs Ollama running. ---
# OLLAMA_BASE_URL=http://localhost:11434

# --- aider executor: it reads these for OSS models ---
# For OpenRouter models (openrouter/...), aider uses OPENROUTER_API_KEY above.
# For local Ollama models (ollama/...):
# OLLAMA_API_BASE=http://localhost:11434
# For LM Studio (lm_studio/...):
# LM_STUDIO_API_BASE=http://localhost:1234/v1
# LM_STUDIO_API_KEY=lm-studio

# codex / kimi / claude / hermes use their own on-disk logins, no keys here.
